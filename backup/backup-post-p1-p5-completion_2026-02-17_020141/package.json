{
  "name": "vite-react",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "hardhat test",
    "test:ci": "cross-env MOCHA_REPORTER=mocha-junit-reporter MOCHA_FILE=reports/test-results.xml hardhat test",
    "coverage": "hardhat coverage",
    "forge:build": "forge build",
    "forge:test": "forge test -vvv",
    "forge:fuzz": "forge test --match-test testFuzz -vvv --runs 10000",
    "forge:coverage": "forge coverage --report lcov",
    "echidna:token": "echidna test/echidna/BashoodEchidna.sol --contract BashoodTokenEchidnaTest --config echidna.yaml",
    "echidna:presale": "echidna test/echidna/BashoodEchidna.sol --contract BashoodEchidnaTest --config echidna.yaml",
    "security:slither": "slither . --config-file slither.config.json --json slither-results.json",
    "security:all": "npm run security:slither && npm run forge:test && npm run echidna:token && npm run echidna:presale",
    "security:report": "node scripts/generate-security-report.js"
  },
  "dependencies": {
    "dotenv": "^16.1.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "^1.0.2"
  },
  "devDependencies": {
    "@chainlink/contracts": "^1.4.0",
    "@eslint/js": "^9.9.0",
    "@foundry-rs/foundry-toolchain": "^1.0.8",
    "@nomicfoundation/hardhat-foundry": "^1.2.0",
    "@nomicfoundation/hardhat-toolbox": "^6.1.0",
    "@openzeppelin/contracts": "^5.4.0",
    "@openzeppelin/contracts-upgradeable": "^5.4.0",
    "@openzeppelin/hardhat-upgrades": "^3.9.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "cross-env": "^7.0.3",
    "eslint": "^9.9.0",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "eth-gas-reporter": "^0.2.27",
    "globals": "^15.9.0",
    "hardhat": "^2.26.3",
    "hardhat-contract-sizer": "^2.10.1",
    "hardhat-gas-reporter": "^2.3.0",
    "mocha-junit-reporter": "^2.0.0",
    "solhint": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.0.1",
    "vite": "^5.4.1"
  }
}
