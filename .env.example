# ==========================================
# BASHOOD - CONFIGURACIÓN DE VARIABLES
# ==========================================

# ==========================================
# BASE NETWORK CONFIGURATION
# ==========================================

# Base Mainnet (Production)
BASE_MAINNET_RPC=https://mainnet.base.org
BASE_MAINNET_PRIVATE_KEY=your_private_key_here

# Base Sepolia Testnet
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_SEPOLIA_PRIVATE_KEY=your_testnet_private_key_here

# ==========================================
# WALLET / ACCOUNTS
# ==========================================

# Owner/Admin account
OWNER_ADDRESS=your_owner_address_here

# Project wallet (receives payments)
PROJECT_WALLET_ADDRESS=your_project_wallet_here

# Operations wallet
OPERATIONS_WALLET_ADDRESS=your_operations_wallet_here

# ==========================================
# API KEYS
# ==========================================

# Etherscan (for Base: Basescan)
ETHERSCAN_API_KEY=your_basescan_api_key
BASESCAN_API_KEY=your_basescan_api_key

# Coinmarketcap (for gas reporter)
COINMARKETCAP_API_KEY=your_coinmarketcap_key

# ==========================================
# DEPLOYMENT CONFIGURATION
# ==========================================

# Presale configuration
NFT_PRICE_ETH=0.1
NFT_PRICE_BHT=100
PRESALE_START=1735000000
PRESALE_END=1735600000
MAX_NFT_SUPPLY=1000

# Burn and discount percentages
BURN_BPS=500
DISCOUNT_BPS=1000

# Oracle configuration
MAX_PRICE_STALENESS=86400

# ==========================================
# MINTING CONFIGURATION
# ==========================================

# IPFS gateway for metadata
IPFS_GATEWAY=https://gateway.pinata.cloud

# Metadata CID
METADATA_CID=your_metadata_cid_here

# ==========================================
# REPORTING
# ==========================================

# Enable gas reporter
REPORT_GAS=true

# Mocha reporter (spec, mocha-junit-reporter)
MOCHA_REPORTER=spec

# ==========================================
# DEVELOPMENT
# ==========================================

# Enable debug logging
DEBUG=false

# Network to use (hardhat, base-sepolia, base-mainnet)
NETWORK=hardhat
