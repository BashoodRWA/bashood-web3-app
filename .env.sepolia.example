# ============================================================================
# Base Sepolia Testnet Configuration
# ============================================================================
# IMPORTANTE: Renombrar a .env.sepolia y completar con tus wallets reales
# NUNCA commitear este archivo con private keys

# Deployer (necesita Base Sepolia ETH del faucet)
PRIVATE_KEY="0x..."

# 5 Wallets del sistema (deben ser DIFERENTES)
TREASURY_WALLET="0x..."           # Recibe 0.5% tax del token
DEVELOPMENT_WALLET="0x..."        # PaymentSplitter 45%
OPERATIONS_WALLET="0x..."         # PaymentSplitter 25%
MARKETING_WALLET="0x..."          # PaymentSplitter 20%
TREASURY_PS_WALLET="0x..."        # PaymentSplitter 10%

# Rescue wallets
ADMIN_WALLET="0x..."              # Rescue admin (puede ser deployer)
EMERGENCY_WALLET="0x..."          # Rescue emergency (puede ser deployer)

# Basescan API (para verificación)
BASESCAN_API_KEY="..."

# RPC (opcional - Hardhat usa public RPC por defecto)
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"

# ============================================================================
# NOTAS:
# ============================================================================
# - Obtener Base Sepolia ETH: https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
# - Necesitarás ~0.5 ETH para deployment completo
# - Las 5 wallets del sistema DEBEN ser diferentes
# - TREASURY_WALLET !== TREASURY_PS_WALLET (diferentes propósitos)
