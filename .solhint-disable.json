{
  "extends": "solhint:recommended",
  "rules": {
    "compiler-version": "off",
    "func-visibility": "off",
    "max-line-length": "off",
    "not-rely-on-time": "off",
    "avoid-suicide": "off",
    "avoid-sha3": "off",
    "no-inline-assembly": "off",
    "bracket-align": "off",
    "code-complexity": "off",
    "function-max-lines": "off",
    "max-states-count": "off",
    "no-empty-blocks": "off",
    "no-unused-vars": "off",
    "payable-fallback": "off",
    "reason-string": "off",
    "constructor-syntax": "off",
    "quotes": "off",
    "const-name-snakecase": "off",
    "contract-name-camelcase": "off",
    "event-name-camelcase": "off",
    "func-name-mixedcase": "off",
    "modifier-name-mixedcase": "off",
    "private-vars-leading-underscore": "off",
    "use-forbidden-name": "off",
    "imports-on-top": "off",
    "ordering": "off",
    "visibility-modifier-order": "off",
    "gas-custom-errors": "off",
    "custom-errors": "off",
    "named-parameters-mapping": "off",
    "no-global-import": "off",
    "use-natspec": "off",
    "gas-indexed-events": "off",
    "gas-strict-inequalities": "off",
    "gas-increment-by-one": "off",
    "gas-small-strings": "off",
    "gas-calldata-parameters": "off",
    "immutable-vars-naming": "off"
  }
}